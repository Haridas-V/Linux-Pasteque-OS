#!/bin/bash
# Exécuté par Calamares (dans la cible) à la fin de l'installation.
set -e
# sécurité : root verrouillé, sudo pour wheel, pare-feu actif, ssh non installé
passwd -l root || true
mkdir -p /etc/sudoers.d
echo "%wheel ALL=(ALL) ALL" > /etc/sudoers.d/010-pasteque-wheel
chmod 440 /etc/sudoers.d/010-pasteque-wheel
systemctl enable firewalld 2>/dev/null || true
# plus d'autologin live sur le système installé
rm -f /etc/sddm.conf.d/10-pasteque.conf
cat > /etc/sddm.conf.d/10-pasteque.conf <<'EOC'
[General]
DisplayServer=wayland
EOC
systemctl enable sddm 2>/dev/null || true
# hostname + locale FR
hostnamectl set-hostname pasteque 2>/dev/null || echo pasteque > /etc/hostname
locale-gen 2>/dev/null || true
# services Pastèque
systemctl enable pasteque-liveuser pasteque-extras pasteque-steamlibs pasteque-bootcheck 2>/dev/null || true
systemctl enable pasteque-update.timer pasteque-steamlibs.timer 2>/dev/null || true
# initramfs de la cible : preset "installé" (hooks standard + pasteque_mods),
# pas le preset archiso de la live
cat > /etc/mkinitcpio.conf <<'EOC'
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev modconf block pasteque_mods keyboard filesystems)
COMPRESSION="xz"
EOC
rm -f /etc/mkinitcpio.d/archiso.preset
cat > /etc/mkinitcpio.d/linux.preset <<'EOC'
ALL_config='/etc/mkinitcpio.conf'
ALL_kver='/boot/vmlinuz-linux'
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
default_kver="/boot/vmlinuz-linux"
EOC
mkdir -p /etc/pacman.d/gnupg
# porte-cle Arch : INDISPENSABLE (pacman.conf a SigLevel=Required) -> erreur fatale
if ! timeout 60 pacman-key --init; then echo "[pasteque-finalize] ERREUR pacman-key --init" >&2; exit 1; fi
if ! timeout 120 pacman-key --populate archlinux; then echo "[pasteque-finalize] ERREUR pacman-key --populate archlinux" >&2; exit 1; fi
# si chiffrement LUKS choisi dans Calamares (/etc/crypttab present) : hook encrypt + cryptodisk
if [ -s /etc/crypttab ]; then
    sed -i 's/HOOKS=(base udev modconf block pasteque_mods keyboard filesystems)/HOOKS=(base udev modconf block keyboard encrypt pasteque_mods filesystems)/' /etc/mkinitcpio.conf
    sed -i 's/^#\?GRUB_ENABLE_CRYPTODISK=.*/GRUB_ENABLE_CRYPTODISK=y/' /etc/default/grub
fi
# preset LTS aussi (sinon mkinitcpio -P ignore le noyau LTS de secours)
cat > /etc/mkinitcpio.d/linux-lts.preset <<'EOC'
ALL_config='/etc/mkinitcpio.conf'
ALL_kver='/boot/vmlinuz-lts'
PRESETS=('default')
default_image="/boot/initramfs-lts.img"
default_kver="/boot/vmlinuz-lts"
EOC
# initramfs : ECHEC FATAL (sinon boot casse apres mise a jour noyau)
mkinitcpio -P || { echo "[pasteque-finalize] ERREUR mkinitcpio -P" >&2; exit 1; }
# menu GRUB avec les autres OS detectes (dual-boot) ; os-prober absent = pas grave
os-prober >/dev/null 2>&1 || true
grub-mkconfig -o /boot/grub/grub.cfg || { echo "[pasteque-finalize] ERREUR grub-mkconfig" >&2; exit 1; }
# installer les extras pour l'utilisateur créé
/usr/bin/python3 /usr/local/bin/pasteque-install-extras 2>/dev/null || true
# entrée de menu pour le gestionnaire d'applications Pastèque
update-desktop-database /usr/share/applications 2>/dev/null || true
echo "[pasteque-finalize] OK"
