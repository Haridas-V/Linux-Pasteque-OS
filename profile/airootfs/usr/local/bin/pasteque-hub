#!/usr/bin/env python3
"""Gestionnaire Pastèque CENTRAL — hub modulaire.
Menu latéral : Vue d'ensemble, Mises à jour (manuel, avec liste), Applications, Jeux,
Fortnite, Performances, Benchmark, Personnalisation, Pare-feu, Diagnostic, Sauvegardes.
Chaque entrée lance l'app dédiée (architecture modulaire : aucun monolithe).
--smoke : instancie la fenêtre en offscreen et vérifie les modules (test CI)."""
import json
import os
import subprocess
import sys

CONF = "/etc/pasteque/pasteque.conf"
BIN = "/usr/local/bin"
# sur un hôte de test (hors ISO), les binaires vivent dans le dépôt :
if not os.path.exists(os.path.join(BIN, "pasteque-appmanager")):
    _h = os.path.abspath(__file__)
    while _h != "/" and not os.path.isdir(os.path.join(_h, "profile/airootfs")):
        _h = os.path.dirname(_h)
    BIN = os.path.join(_h, "profile/airootfs/usr/local/bin")

MODULES = [
    ("🏠 Vue d'ensemble", None),
    ("🔄 Mises à jour", "updates"),
    ("📦 Applications", ["pasteque-appmanager"]),
    ("🎮 Jeux", ["pasteque-games"]),
    ("🍉 Fortnite", ["pasteque-fortnite"]),
    ("⚡ Performances / priorités", ["pasteque-priorites"]),
    ("📊 Monitoring", ["pasteque-monitor"]),
    ("🧪 Benchmark", ["pasteque-benchmark"]),
    ("🎨 Personnalisation", ["pasteque-personnalise"]),
    ("🛡️ Pare-feu", ["pasteque-parefeu"]),
    ("🔍 Diagnostic", ["pasteque-diagnostic"]),
    ("🗑️ Corbeille / sauvegardes", ["pasteque-appmanager"]),
    ("🪄 Générateur d'apps (FR)", ["pasteque-genere"]),
]


def conf_get(k, d):
    try:
        for line in open(CONF):
            if line.strip().startswith(k + "="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return d


def pending_updates():
    import shutil
    if not shutil.which("pacman"):
        return []
    r = subprocess.run(["pacman", "-Qu"], capture_output=True, text=True)
    return [l for l in r.stdout.splitlines() if l.strip()]


def smoke():
    # pas besoin de Qt pour le smoke : on vérifie les modules et les binaires cibles
    assert len(MODULES) >= 10
    for name, target in MODULES:
        if isinstance(target, list):
            assert os.path.exists(os.path.join(BIN, target[0])), target
    print("smoke OK: %d modules, mises a jour en attente: %d" % (len(MODULES), len(pending_updates())))
    return 0


def gui():
    from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
                                 QListWidget, QLabel, QPushButton, QStackedWidget, QTableWidget,
                                 QTableWidgetItem, QMessageBox, QHeaderView)
    from PyQt6.QtCore import Qt
    from PyQt6.QtGui import QFont

    class Hub(QMainWindow):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("🍉 Gestionnaire Pastèque")
            w = QWidget(); self.setCentralWidget(w)
            h = QHBoxLayout(w)
            self.menu = QListWidget()
            self.menu.setFixedWidth(260)
            for name, _ in MODULES:
                self.menu.addItem(name)
            self.menu.currentRowChanged.connect(self.switch)
            h.addWidget(self.menu)
            self.stack = QStackedWidget()
            h.addWidget(self.stack)
            self.stack.addWidget(self.page_overview())
            self.stack.addWidget(self.page_updates())
            for _ in MODULES[2:]:
                self.stack.addWidget(QWidget())  # placeholder, l'app se lance au clic
            self.menu.setCurrentRow(0)
            self.resize(980, 640)

        def switch(self, i):
            name, target = MODULES[i]
            self.stack.setCurrentIndex(i)
            if i in (0, 1):
                if i == 0:
                    self.refresh_overview()
                else:
                    self.refresh_updates()
                return
            if isinstance(target, list):  # lance l'app dédiée
                subprocess.Popen([os.path.join(BIN, target[0])])
                self.menu.setCurrentRow(0)
                self.stack.setCurrentIndex(0)
                self.refresh_overview()

        def page_overview(self):
            p = QWidget(); v = QVBoxLayout(p)
            self.ov = QLabel(); self.ov.setFont(QFont("Sans", 12))
            v.addWidget(self.ov)
            b = QPushButton("🔄 Vérifier les mises à jour")
            b.clicked.connect(lambda: self.menu.setCurrentRow(1))
            v.addWidget(b)
            v.addStretch(1)
            return p

        def refresh_overview(self):
            up = pending_updates()
            try:
                du = subprocess.run(["df", "-h", "/"], capture_output=True, text=True).stdout.splitlines()[-1]
            except Exception:
                du = "?"
            auto = conf_get("AUTO_UPDATE", "0") == "1"
            self.ov.setText(
                "🍉 Pastèque Linux — tout est ici.\n\n"
                "Mises à jour en attente : %d (mise à jour MANUELLE : onglet 🔄)\n"
                "Mode auto au repos : %s\n"
                "Disque / : %s\n"
                "Sécurité : pare-feu ON, root verrouillé, sudo contrôlé (voir 🛡️ et 🔍)" % (
                    len(up), "oui" if auto else "non (contrôle manuel)", du))

        def page_updates(self):
            p = QWidget(); v = QVBoxLayout(p)
            v.addWidget(QLabel("Mises à jour disponibles (contrôle total : rien n'est installé sans votre clic) :"))
            self.up_table = QTableWidget(0, 2)
            self.up_table.setHorizontalHeaderLabels(["Paquet", "Version actuelle → nouvelle"])
            self.up_table.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
            v.addWidget(self.up_table)
            h = QHBoxLayout()
            self.b_check = QPushButton("🔄 Rechercher les mises à jour")
            self.b_check.clicked.connect(self.refresh_updates)
            self.b_install = QPushButton("⬇️ Installer maintenant (snapshot Btrfs auto avant)")
            self.b_install.clicked.connect(self.install_updates)
            h.addWidget(self.b_check); h.addWidget(self.b_install)
            v.addLayout(h)
            return p

        def refresh_updates(self):
            subprocess.run(["pacman", "-Sy"], capture_output=True)
            rows = pending_updates()
            self.up_table.setRowCount(0)
            for i, l in enumerate(rows):
                parts = l.split()
                self.up_table.insertRow(i)
                self.up_table.setItem(i, 0, QTableWidgetItem(parts[0] if parts else ""))
                self.up_table.setItem(i, 1, QTableWidgetItem(" ".join(parts[1:]) if len(parts) > 1 else ""))

        def install_updates(self):
            if self.up_table.rowCount() == 0:
                QMessageBox.information(self, "Mises à jour", "Aucune mise à jour en attente.")
                return
            if QMessageBox.question(self, "Confirmer",
                                    "Installer %d mise(s) à jour maintenant ?\nSnapshot Btrfs automatique avant." %
                                    self.up_table.rowCount()) != QMessageBox.Yes:
                return
            r = subprocess.run(["pkexec", os.path.join(BIN, "pasteque-update"), "--force"],
                               capture_output=True, text=True)
            QMessageBox.information(self, "Mise à jour",
                                    ("Terminée ✅\nRedémarrage conseillé." if r.returncode == 0
                                     else "Échec, voir le journal.\n" + (r.stderr or "")[-400:]))
            self.refresh_updates(); self.refresh_overview()

    app = QApplication(sys.argv)
    m = Hub(); m.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(smoke() if "--smoke" in sys.argv else gui())
