#!/usr/bin/env python3
"""Pour chaque jeu Steam installé dont l'anti-cheat est incompatible Linux,
injecte une option de lancement qui affiche un avertissement avant le jeu.
Réversible : retirer l'entrée LaunchOptions restaure le comportement par défaut."""
import glob
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
DB = "/usr/share/pasteque/anticheat-db.json"
STEAM = os.path.join(HOME, ".steam/steamapps")


def conf_enabled():
    try:
        for line in open("/etc/pasteque/pasteque.conf"):
            if line.strip().startswith("ANTICHEAT_WARNINGS="):
                return line.split("=", 1)[1].strip() == "1"
    except OSError:
        pass
    return True


def notify(appid, info):
    subprocess.run(["notify-send", "Pastèque — anti-cheat",
                    "%s : %s\n%s" % (info.get("name", appid), info.get("status", "?"), info.get("detail", ""))],
                   capture_output=True)


def query(term):
    """Mode requete : pasteque-anticheat <appid|nom de jeu> -> affiche le statut anti-cheat."""
    try:
        data = json.load(open(DB))
    except OSError:
        print("base anti-cheat illisible")
        return 1
    db = dict(data.get("appids", {}))
    for k, v in data.get("games", {}).items():
        db.setdefault(k, v)
    t = term.strip().lower()
    hit = None
    if term.strip().isdigit() and term.strip() in db:
        hit = (term.strip(), db[term.strip()])
    else:
        for k, v in db.items():
            if t in k.lower() or t in v.get("name", "").lower():
                hit = (k, v)
                break
    if not hit:
        print("Pas d'entree pour '%s' (voir https://areweanticheatyet.com)" % term)
        return 1
    k, v = hit
    print("%s [%s] %s" % (v.get("name", k), v.get("status", "?"), v.get("detail", "")))
    if v.get("launcher"):
        print("Lancer via : %s" % v["launcher"])
    return 0 if v.get("status") == "OK" else 2


def main():
    if len(sys.argv) > 1:
        sys.exit(query(" ".join(sys.argv[1:])))
    if not conf_enabled():
        return
    try:
        db = json.load(open(DB)).get("appids", {})
    except OSError:
        return
    bad = {a: i for a, i in db.items() if i.get("status") == "KO"}
    for acf in glob.glob(os.path.join(STEAM, "appmanifest_*.acf")):
        txt = open(acf, encoding="utf-8", errors="replace").read()
        m = re.search(r'"appid"\s*"(\d+)"', txt)
        if not m or m.group(1) not in bad:
            continue
        appid = m.group(1)
        info = bad[appid]
        # option de lancement par défaut Steam (userdata/<uid>/config/localconfig.vdf)
        for lc in glob.glob(os.path.join(HOME, ".steam/userdata/*/config/localconfig.vdf")):
            content = open(lc).read()
            key = '"LaunchOptions"'
            warn = 'pasteque-anticheat-warn %s %%command%%' % appid
            if warn in content:
                continue
            # on écrit via le helper dédié pour rester robuste
            helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), "pasteque-anticheat-setlaunch")
            try:
                subprocess.run([sys.executable, helper, appid, "set", lc], capture_output=True)
            except OSError:
                pass


if __name__ == "__main__":
    main()
