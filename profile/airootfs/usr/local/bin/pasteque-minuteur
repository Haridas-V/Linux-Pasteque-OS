#!/usr/bin/env python3
"""Minuteur / chronomètre Pastèque — compte à rebours + chrono, notification à la fin.
--smoke : test headless."""
import json
import os
import sys
import time

DATA = os.path.expanduser("~/.local/share/pasteque/minuteur.json")


def smoke():
    d = {"presets": [{"nom": "Pâtes", "secondes": 480}, {"nom": "Test", "secondes": 5}]}
    os.makedirs(os.path.dirname(DATA), exist_ok=True)
    json.dump(d, open(DATA, "w"))
    assert json.load(open(DATA))["presets"][0]["secondes"] == 480
    print("smoke OK")
    return 0


def gui():
    from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
                                 QLabel, QPushButton, QSpinBox, QComboBox)
    from PyQt6.QtCore import QTimer, Qt
    import subprocess

    class Minuteur(QMainWindow):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("⏱️ Minuteur — Pastèque")
            self.restant = 0
            self.timer = QTimer(self)
            self.timer.timeout.connect(self.tick)
            w = QWidget(); self.setCentralWidget(w)
            v = QVBoxLayout(w)
            self.aff = QLabel("00:00")
            self.aff.setAlignment(Qt.AlignmentFlag.AlignCenter)
            from PyQt6.QtGui import QFont
            self.aff.setFont(QFont("Sans", 48, QFont.Bold))
            v.addWidget(self.aff)
            h = QHBoxLayout()
            self.min = QSpinBox(); self.min.setRange(0, 999); self.min.setValue(5)
            self.sec = QSpinBox(); self.sec.setRange(0, 59); self.sec.setValue(0)
            h.addWidget(QLabel("min:")); h.addWidget(self.min)
            h.addWidget(QLabel("sec:")); h.addWidget(self.sec)
            v.addLayout(h)
            self.presets = QComboBox()
            try:
                for p in json.load(open(DATA)).get("presets", []):
                    self.presets.addItem("%s (%d min)" % (p["nom"], p["secondes"] // 60), p["secondes"])
            except Exception:
                pass
            self.presets.currentIndexChanged.connect(self.appliquer_preset)
            v.addWidget(self.presets)
            h2 = QHBoxLayout()
            self.start = QPushButton("▶ Démarrer"); self.start.clicked.connect(self.demarrer)
            self.stop = QPushButton("⏹ Arrêter"); self.stop.clicked.connect(self.arreter)
            h2.addWidget(self.start); h2.addWidget(self.stop)
            v.addLayout(h2)
            self.resize(420, 320)

        def appliquer_preset(self, i):
            s = self.presets.itemData(i)
            if s:
                self.min.setValue(s // 60); self.sec.setValue(s % 60)

        def demarrer(self):
            self.restant = self.min.value() * 60 + self.sec.value()
            self.timer.start(1000)
            self.aff.setText(self.fmt())

        def arreter(self):
            self.timer.stop(); self.restant = 0; self.aff.setText("00:00")

        def fmt(self):
            return "%02d:%02d" % (self.restant // 60, self.restant % 60)

        def tick(self):
            if self.restant > 0:
                self.restant -= 1
                self.aff.setText(self.fmt())
            if self.restant == 0:
                self.timer.stop()
                subprocess.run(["notify-send", "⏱️ Minuteur Pastèque", "Terminé !"], capture_output=True)

    app = QApplication(sys.argv)
    m = Minuteur(); m.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(smoke() if "--smoke" in sys.argv else gui())
