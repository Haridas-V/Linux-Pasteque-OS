GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Pasteque Linux"
GRUB_CMDLINE_LINUX_DEFAULT="console=ttyS0,115200"
GRUB_CMDLINE_LINUX=""
GRUB_ENABLE_CRYPTODISK=y   # necessaire si chiffrement LUKS choisi dans Calamares
GRUB_DISABLE_OS_PROBER=false  # dual-boot : lister les autres OS dans le menu GRUB
GRUB_DISABLE_RECOVERY=true
